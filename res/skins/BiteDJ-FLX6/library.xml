<!DOCTYPE template>
<!--
  The Browse page: the library panel at full height over the deck strips.

  The [Sidebar],sidebar_visible toggle and its Back button are gone. They
  existed because at the 480px design floor the explorer and the track table
  could not share a row, so the page swapped between them. At 1280 both fit.
-->
<Template>
  <WidgetGroup>
    <ObjectName>LibraryWrapper</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>
      <Template src="skin:librarypanel.xml"></Template>
      <Template src="skin:deckstrips.xml"></Template>
    </Children>
  </WidgetGroup>
</Template>
