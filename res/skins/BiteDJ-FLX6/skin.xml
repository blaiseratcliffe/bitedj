<skin>
	<manifest>
		<title>Bite DJ FLX6</title>
		<author>Alyxxx Interactive LLC</author>
		<version>1.0.0</version>
		<description></description>
		<language>*</language>
		<license>GPL</license>
		<attributes>
			<attribute config_key="[App],num_decks">4</attribute>
			<attribute config_key="[App],num_samplers">16</attribute>
			<attribute persist="true" config_key="[Skin],show_maximized_library">0</attribute>
			<attribute persist="true" config_key="[Master],skin_settings">0</attribute>
			<attribute persist="true" config_key="[Skin],show_microphones">0</attribute>
			<attribute persist="true" config_key="[VinylControl],show_vinylcontrol">0</attribute>
			<attribute persist="true" config_key="[Skin],show_preview_decks">0</attribute>
			<attribute persist="true" config_key="[Skin],show_library_coverart">0</attribute>
			<attribute config_key="[Sidebar],sidebar_visible">1</attribute>
			<!-- The Play page waveform grid's per-row cell floor, in pixels.
			     No C++ owns these keys, so this manifest creates them: a
			     persisted ControlPushButton whose TOGGLE mode only affects
			     MIDI, leaving setParameter/getParameter identity, so it holds
			     a pixel count perfectly well. waveform.xml binds each cell's
			     minimumHeight to one of them; the bottom one is what the
			     Settings General page's Split row writes. persist="true" seeds
			     mixxx.cfg only when the key is absent, so a user's choice
			     wins over the default on every later launch. -->
			<attribute persist="true" config_key="[BiteDJ],waveform_min_top">178</attribute>
			<attribute persist="true" config_key="[BiteDJ],waveform_min_bottom">142</attribute>
		</attributes>
	</manifest>

	<ObjectName>Mixxx</ObjectName>
	<Style src="skin:style.qss"/>
	<!-- Deliberately the panel's exact resolution, not a smaller floor. Toggling
	     Night/Day calls rebootMixxxView(), which rebuilds every widget; during that
	     rebuild adjustSize() can collapse the window toward this minimum and win a
	     race against Qt re-asserting fullscreen, leaving the app silently stuck at
	     the minimum size instead of fullscreen until the process restarts. With
	     nothing smaller to collapse to, there is nothing for adjustSize() to win.
	     Lowering this brings that bug back. -->
	<MinimumSize>1280,720</MinimumSize>
	<SizePolicy>me,me</SizePolicy>
	<Layout>vertical</Layout>

	<LaunchImageStyle>
      LaunchImage { background-color: #000 }
	  QLabel {
	    image: url(skin:/images/boot_mark.png);
	    margin-bottom: 12px;
        min-width: 964px;
        min-height: 135px;
        max-width: 964px;
        max-height: 135px;
	  }
      QProgressBar {
	    background-color: #a7a9ac;
        max-height: 8px;
	  }
	  QProgressBar::chunk {
	    background-color: #e24a93;
	  }
	</LaunchImageStyle>

	<Children>
		<SingletonDefinition>
			<ObjectName>Topbar_Singleton</ObjectName>
			<Children>
				<Template src="skin:topbar.xml"/>
			</Children>
		</SingletonDefinition>
		<SingletonDefinition>
			<ObjectName>TrackTable_Singleton</ObjectName>
			<Children>
				<Library>
					<ObjectName>Library</ObjectName>
					<Size>0me,0me</Size>
					<BgColor>#000</BgColor>
					<FgColor>#75001a</FgColor>
					<TrackTableBackgroundColorOpacity>0.4</TrackTableBackgroundColorOpacity>
				</Library>
			</Children>
		</SingletonDefinition>
		<SingletonDefinition>
			<ObjectName>Sidebar_Singleton</ObjectName>
			<Children>
				<LibrarySidebar>
					<ObjectName>LibrarySidebar</ObjectName>
					<Size>0me,0me</Size>
					<HiddenFeatures>Tracks,Auto DJ,Playlists,Crates</HiddenFeatures>
				</LibrarySidebar>
			</Children>
		</SingletonDefinition>
		<SingletonDefinition>
			<ObjectName>Samplers_Singleton</ObjectName>
			<Children>
				<Template src="skin:samplers.xml"/>
			</Children>
		</SingletonDefinition>
		<SingletonDefinition>
			<ObjectName>Levels_Singleton</ObjectName>
			<Children>
				<Template src="skin:levels.xml"/>
			</Children>
		</SingletonDefinition>
		<SingletonDefinition>
			<ObjectName>Settings_Singleton</ObjectName>
			<Children>
				<Template src="skin:settings.xml"/>
			</Children>
		</SingletonDefinition>

		<WidgetGroup>
			<ObjectName>SkinContainer</ObjectName>
			<Layout>vertical</Layout>
			<SizePolicy>me,me</SizePolicy>
			<Children>
				<WidgetGroup>
					<Layout>vertical</Layout>
					<SizePolicy>me,me</SizePolicy>
					<Children>
						<!-- Stacked so the strips overlay the topbar (first child
						     is topmost) instead of reflowing the page below. -->
						<WidgetGroup>
							<ObjectName>TopbarStack</ObjectName>
							<Layout>stacked</Layout>
							<Size>0me,44f</Size>
							<Children>
								<NotificationStrip>
									<ObjectName>NotificationStrip</ObjectName>
									<SizePolicy>me,me</SizePolicy>
									<Connection>
										<ConfigKey>[Notifications],visible</ConfigKey>
										<BindProperty>visible</BindProperty>
									</Connection>
								</NotificationStrip>
								<WidgetGroup>
									<ObjectName>SoftTakeoverStrip</ObjectName>
									<Layout>horizontal</Layout>
									<SizePolicy>me,me</SizePolicy>
									<Children>
										<WidgetGroup>
											<Size>0me,0me</Size>
										</WidgetGroup>
										<Label>
											<ObjectName>SoftTakeoverLabel</ObjectName>
											<Text>MOVE CONTROL TO SYNC</Text>
											<Size>60max,me</Size>
										</Label>
										<SoftTakeoverIndicator>
											<ObjectName>SoftTakeoverArrow</ObjectName>
											<Size>120max,me</Size>
											<Color>#f15921</Color>
										</SoftTakeoverIndicator>
										<WidgetGroup>
											<Size>0me,0me</Size>
										</WidgetGroup>
									</Children>
									<Connection>
										<ConfigKey>[SoftTakeover],active</ConfigKey>
										<BindProperty>visible</BindProperty>
									</Connection>
								</WidgetGroup>
								<SingletonContainer>
									<ObjectName>Topbar_Singleton</ObjectName>
								</SingletonContainer>
							</Children>
						</WidgetGroup>
						<WidgetStack currentpage="[Tab],current">
							<ObjectName>TabStack</ObjectName>
							<Children>
								<WidgetGroup trigger="[Tab],overview">
									<ObjectName>OverviewPage</ObjectName>
									<Layout>vertical</Layout>
									<SizePolicy>me,me</SizePolicy>
									<Children>
										<Template src="skin:overview.xml"></Template>
									</Children>
								</WidgetGroup>
								<WidgetGroup trigger="[Tab],library" on_hide_select="0">
									<ObjectName>LibraryPage</ObjectName>
									<Layout>vertical</Layout>
									<SizePolicy>me,me</SizePolicy>
									<Children>
										<Template src="skin:library.xml"></Template>
									</Children>
								</WidgetGroup>
								<SingletonContainer trigger="[Tab],samplers" on_hide_select="0">
									<ObjectName>Samplers_Singleton</ObjectName>
								</SingletonContainer>
								<!-- Child order is load-bearing: ControllerSettings
								     navigates to Settings by index (overview=0,
								     library=1, samplers=2, levels=3, settings=4).
								     Reorder here and that constant must move too. -->
								<SingletonContainer trigger="[Tab],levels" on_hide_select="0">
									<ObjectName>Levels_Singleton</ObjectName>
								</SingletonContainer>
								<SingletonContainer trigger="[Tab],settings" on_hide_select="0">
									<ObjectName>Settings_Singleton</ObjectName>
								</SingletonContainer>
							</Children>
						</WidgetStack>
					</Children>
				</WidgetGroup>
			</Children>
		</WidgetGroup>
	</Children>
</skin>
