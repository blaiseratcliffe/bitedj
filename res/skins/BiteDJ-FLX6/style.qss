#Mixxx {
  background-color: black;
}

/* Opaque black under the tab stacks so swapping pages never reveals the
 * cleared (white) backing store for a frame before the root repaints.
 * Pages paint on top; transparent areas now fall back to black, not white. */
#TabStack,
#SettingsStack {
  background-color: black;
}

* {
  font-family: 'Inter', sans-serif, 'Monospace';
}

QMenuBar, QMenuBar::item, QMenu, QMenu::item {
  background-color: #a7a9ac;
}

QMenuBar::item:pressed, QMenu::item:selected, QMenu::item:pressed {
    background-color: rgba(255,255,255,0.2);
}

/************************************************************************/
/*     Buttons                                                          */
/************************************************************************/

WPushButton {
  color: #e5e6ea;
  background-color: transparent;
  border: 1px solid #32323c;
  border-radius: 2px;
  outline: none;
}

WPushButton:hover {
  border: 1px solid #5F5F5F;
}

WPushButton[value="1"] {
  color: #e5e6ea;
  border: 1px solid #5F5F5F;
  background-color: #32323c;
}

WPushButton[value="1"]:hover {
  border: 1px solid #4B4B4B;
  background-color: #30303a;
}

/************************************************************************/
/*     BeatFX                                                           */
/************************************************************************/

/* layoutSpacing, not a margin on the tab bar. A QSS margin on a plain widget
 * in a layout is not reliably honoured here, and the 12px one on
 * #FxPanel_TabBar measured as no gap at all, leaving the active purple sub-tab
 * touching the active purple route button below it and reading as one shape.
 * qproperty-layoutSpacing is a real WWidgetGroup property and does work. */
#BeatFX_Container {
  padding: 8px;
  qproperty-layoutSpacing: 16;
}

/* The FX page: one column per effect slot, with the per-unit routing and mix
 * rows above and below them.
 *
 * None of these carry a qproperty-layoutAlignment, deliberately. That property
 * does nothing in this skin — WWidgetGroup::setLayoutAlignment calls the
 * one-argument QLayout::setAlignment, which sets the layout's own alignment as
 * an item in a parent layout, and every group here owns its layout outright.
 * The trailing BeatFX_Spacer in each column is what actually packs its
 * children to the top. The AlignVCenter #BeatFX_Header used to carry was inert
 * as well; it only looked like it worked because that group had a fixed 140f
 * height and so had no slack to misplace. */
#BeatFX_SlotRow {
  qproperty-layoutSpacing: 16;
}

/* 4, not 8. The worst case is Graphic EQ: eight continuous parameters, so
 * eight knob rows in one column. At a 44px knob and 4px spacing that is 384px
 * against the ~450px a column has under the Active toggle. At 56 and 8 the
 * eighth knob ran off the bottom of the screen. */
#BeatFX_SlotColumn {
  qproperty-layoutSpacing: 4;
}

#BeatFX_UnitRow {
  qproperty-layoutSpacing: 8;
}

/* Separates the route/mix row from the four slot columns below it. Again a
 * layoutSpacing rather than a margin, for the reason given on the container. */
#FxPanel_Page {
  qproperty-layoutSpacing: 16;
}

#BeatFX_UnitLabel {
  color: #a7a9ac;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

/* FX / KEY page tabs. Same select-only bar as the Settings sub-tabs. The group
 * carries a fixed width in effects.xml rather than filling the row, because
 * two buttons stretched across the whole 1280 tab would be absurd. The gap
 * below it comes from #BeatFX_Container's layoutSpacing, not from a margin
 * here; the margin this rule used to carry measured as no gap at all. */
#FxPanel_TabBar {
  qproperty-layoutSpacing: 8;
}

#FxPanel_TabBar WPushButton {
  background-color: transparent;
  border: 2px solid #32323c;
  color: #a7a9ac;
  font-size: 15px;
  font-weight: bold;
  text-transform: uppercase;
}

#FxPanel_TabBar WPushButton[value="1"] {
  background-color: #855ea7;
  border-color: #855ea7;
  color: #e7e8e9;
}

/* The AlignTop this rule used to carry was inert (see the note above
 * #BeatFX_SlotRow); the FX page's own row policies do the packing, and the
 * KEY page's blocks are held up by their me,max wrappers. The one live
 * property for this selector is the layoutSpacing set further up. */

/************************************************************************/
/*     Cue drawer                                                       */
/************************************************************************/

#CuePanel {
  background-color: #151515;
  /* Vertical padding removed: the drawer's 120px height cap forces Qt to
     shrink the fixed-height pad rows to fit, so any padding taken off the
     top/bottom comes straight out of the pads. Horizontal padding is kept
     to inset the outermost pads from the screen edge. Do not restore the
     vertical half. */
  padding: 0 2px;
}

#CuePanel_Header {
  qproperty-layoutSpacing: 4;
}

#CuePanel_DeckLabel {
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
  color: #a7a9ac;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

/* Bank toggle. Labelled with the bank on show, the same off/active
 * convention as BeatFX_ActiveToggle. */
#CuePanel_BankToggle {
  background-color: transparent;
  border: 2px solid #32323c;
  border-radius: 2px;
  color: #a7a9ac;
  font-size: 15px;
  font-weight: bold;
  text-transform: uppercase;
}

#CuePanel_BankToggle[value="1"] {
  background-color: #855ea7;
  border-color: #855ea7;
  color: #e7e8e9;
}

#CuePanel_Close {
  background-color: transparent;
  border: 2px solid #32323c;
  border-radius: 2px;
  color: #a7a9ac;
  font-size: 15px;
  font-weight: bold;
}

#CuePanel_Close:pressed {
  border-color: #855ea7;
  color: #e7e8e9;
}

#CuePanel_Grid {
  qproperty-layoutSpacing: 4;
}

#CuePanel_Row {
  qproperty-layoutSpacing: 4;
}

/* Empty slot. The set and active states get their background from the cue's
 * own colour, applied by WHotcueButton as an inline stylesheet, so only the
 * text and border are set here. */
#CuePad {
  background-color: #1a1a1a;
  border: 1px solid #32323c;
  border-radius: 3px;
  color: #4a4a4a;
  font-size: 20px;
  font-weight: bold;
}

#CuePad[displayValue="1"], #CuePad[displayValue="2"] {
  color: #e7e8e9;
  border-color: #5f5f5f;
}

/* WHotcueButton reports whether the cue colour is light or dark so the label
 * can stay legible against it. Exempt from daylight-mode inversion, both of
 * them: the background these are paired against is the cue's OWN colour, set
 * by WHotcueButton as an inline stylesheet and deliberately never inverted (a
 * red cue is red in both modes), and the light/dark property is computed from
 * that same un-inverted colour. Invert the label and a white saved-loop pad
 * gets white text. */
/* no-invert */
#CuePad[light="true"] {
  color: #101010;
}

/* no-invert */
#CuePad[dark="true"] {
  color: #e7e8e9;
}

/* A pad holding a saved loop rather than a plain cue point. */
#CuePad[type="loop"] {
  border: 2px solid #6ee128;
}

/* Saved loop currently running. */
#CuePad[displayValue="2"] {
  border: 2px solid #c9372c;
}

#BeatFX_ParamRow {
  padding: 2px 0px;
}

#BeatFX_ParamLabel {
  color: #a7a9ac;
  font-size: 16px;
  font-weight: bold;
  text-transform: uppercase;
  padding-right: 4px;
}

#BeatFX_BucketRow {
  qproperty-layoutSpacing: 2;
}

#BeatFX_BucketButton {
  color: #a7a9ac;
  background-color: #1a1a1a;
  border: 1px solid #3a3a3a;
  border-radius: 2px;
  font-size: 16px;
  font-weight: bold;
}

#BeatFX_BucketButton[displayValue="1"] {
  color: #c9372c;
  border-color: #c9372c;
  background-color: #2a1a13;
}

#BeatFX_ActiveToggle {
  color: #a7a9ac;
  background-color: #1a1a1a;
  border: 1px solid #3a3a3a;
  border-radius: 3px;
  font-weight: bold;
  text-transform: uppercase;
}

#BeatFX_ActiveToggle[value="1"] {
  color: #c9372c;
  border-color: #c9372c;
}

/* Deck-routing toggles for [EffectRack1_EffectUnit1]. All four share one active
 * colour: the deck strips carry no per-deck colour any more, so there is no
 * per-deck colour system here to mirror. The group that held them was called
 * BeatFX_DeckRouting while it was a row inside the old narrow header; it is
 * BeatFX_UnitRow now and also carries the mix readout, so its rule lives with
 * the other FX page rules further up. */

#BeatFX_DeckAssign1,
#BeatFX_DeckAssign2,
#BeatFX_DeckAssign3,
#BeatFX_DeckAssign4 {
  background-color: #1a1a1a;
  border: 1px solid #3a3a3a;
  border-radius: 3px;
  color: #a7a9ac;
  font-size: 20px;
  font-weight: bold;
}

#BeatFX_DeckAssign1[displayValue="1"],
#BeatFX_DeckAssign2[displayValue="1"],
#BeatFX_DeckAssign3[displayValue="1"],
#BeatFX_DeckAssign4[displayValue="1"] {
  background-color: #855ea7;
  border-color: #855ea7;
  color: #1a1a1a;
}

#BeatFX_WetRow {
  qproperty-layoutAlignment: 'AlignVCenter';
  qproperty-layoutSpacing: 4;
}

#BeatFX_MixLabel {
  color: #a7a9ac;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#BeatFX_MixMeter {
  padding: 0 1px;
}

/* KEY page: one stacked block per deck, +/-2 semitone nudges and reset. */
/* Four blocks share the KEY page's row, so the padding is now a gutter
 * between columns rather than a gap between stacked rows. */
#KeyFX_DeckBlock {
  padding: 0 12px;
}

#KeyFX_DeckHeader {
  qproperty-layoutAlignment: 'AlignVCenter';
  qproperty-layoutSpacing: 4;
}

#KeyFX_DeckLabel_1,
#KeyFX_DeckLabel_2,
#KeyFX_DeckLabel_3,
#KeyFX_DeckLabel_4 {
  color: #855ea7;
  font-size: 15px;
  font-weight: bold;
  text-transform: uppercase;
}

/* Orange whenever the playing key differs from the file's key. */
#KeyFX_DeckKey {
  color: #e7e8e9;
  font-size: 18px;
  font-weight: bold;
}

#KeyFX_DeckKey[highlight="1"] {
  color: #c9372c;
}

#KeyFX_ButtonRow {
  qproperty-layoutSpacing: 4;
}

#KeyFX_Down,
#KeyFX_Up,
#KeyFX_Reset {
  background-color: #1a1a1a;
  border: 1px solid #3a3a3a;
  border-radius: 3px;
  color: #a7a9ac;
  font-size: 22px;
  font-weight: bold;
}

#KeyFX_Reset {
  font-size: 16px;
  text-transform: uppercase;
}

#KeyFX_Down:pressed,
#KeyFX_Up:pressed,
#KeyFX_Reset:pressed {
  border-color: #c9372c;
  color: #c9372c;
}

/************************************************************************/
/*     Effects                                                          */
/************************************************************************/

/* Opaque on purpose, unlike the transparent WPushButtons around it. Those are
 * plain QWidgets — transparent means the skin-painted parent shows through. A
 * QComboBox is a *native-styled* control: transparent leaves QStyle to paint it
 * from the widget palette, which is the platform default and the one surface
 * neither daylight-mode hook can reach, so it stayed black on a light page.
 * Declaring the surface here puts it back inside the stylesheet, which is what
 * the inversion works from. Colours are the BeatFX control surface its
 * neighbours use (BucketButton / ActiveToggle / DeckAssign). */
WEffectSelector {
  background-color: #1a1a1a;
  border: 1px solid #3a3a3a;
  border-radius: 2px;
  color: #a7a9ac;
  font-size: 14px;
  font-weight: bold;
  padding: 4px;
  text-transform: uppercase;
}
/* The drop-down button is a second palette-drawn surface: left unstyled QStyle
 * paints its raised frame from the platform palette, which is the same black
 * box the selector body was. Styling it flattens the frame — but Qt then stops
 * drawing the built-in arrow instead of falling back to it, so the arrow has to
 * come from the skin. As a QSS url() it rides the icon-inversion pipeline and
 * flips with everything else. */
WEffectSelector::drop-down {
  background-color: transparent;
  border: 0;
  subcontrol-origin: padding;
  subcontrol-position: center right;
  width: 24px;
}

WEffectSelector::down-arrow {
  image: url(skin:icons/dropdown_arrow.svg);
  width: 12px;
  height: 12px;
}

/* The open drop-down is a separate top-level popup, not a child of the closed
 * combo, so it inherits none of the above. Left unstyled it falls back to the
 * system palette — black rows that daylight mode never sees, because nothing
 * in the skin declared them. Styling it explicitly both fixes the popup and
 * puts it inside the stylesheet, which is what the inversion works from. */
WEffectSelector QAbstractItemView {
  background-color: #1a1a1a;
  border: 1px solid #32323c;
  color: #e5e6ea;
  selection-background-color: #855ea7;
  selection-color: #e7e8e9;
}

/************************************************************************/
/*     Library                                                          */
/************************************************************************/

#LibraryWrapper QScrollBar {
  background-color: #855ea7;
}

#LibraryWrapper QScrollBar::handle:horizontal {
  border: 0;
}

#LibraryWrapper QScrollBar:horizontal {
  height: 0;
  width: 0;
}

#LibraryWrapper QScrollBar:vertical {
  border: 0;
  width: 10px;
}

#LibraryWrapper QScrollBar::add-page,
#LibraryWrapper QScrollBar::sub-page {
  background-color: black;
}

#LibraryWrapper QScrollBar::add-line,
#LibraryWrapper QScrollBar::sub-line {
  height: 0;
  width: 0;
}

#LibraryWrapper WTrackTableViewHeader::section {
  background-color: #32323c;
  color: #e5e6ea;
  font-weight: bold;
  font-size: 12px;
  /* Measured: the section's own sizeHint is floored by the table's config
   * font (22px metrics), not by font-size above, so dropping 18px to 12px
   * took the cell from only 28px to 26px and left the slack sitting below
   * the text (4px above, 13px below). height pins the cell; the vertical
   * margin was 4px more of the same slack. Keep the horizontal 2px, which
   * is what separates one column heading from the next.
   * Measured result: a 13px cell with the 9px text balanced 2px above and
   * 2px below, against 26px and 4/13 before. The sort indicator still
   * draws. Reach for height here, not font-size. */
  margin: 0px 2px;
  padding: 0px;
  height: 14px;
  text-transform: uppercase;
}

/* Rows for tracks already played this session render in blue.
   Cleared by Settings -> General -> Played -> Reset. Keep in sync with
   kPlayedTrackColor in browsetablemodel.cpp, which tints the Computer/USB
   file browser (a QStandardItemModel with no styleable view property). */
#LibraryWrapper WTrackTableView {
  qproperty-trackPlayedColor: #4aa3e0;
}

#LibraryWrapper QTableView,
#LibraryWrapper WLibraryTextBrowser {
  background-color: #111;
  alternate-background-color: #222;
  selection-background-color: #e5e6ea;
  color: white;
  selection-color: black;
  font-size: 14px;
  padding-top: 5px;
  padding-bottom: 5px;
}

#LibraryWrapper WLibrarySidebar {
  background-color: #111;
  selection-background-color: #9bcceb;
  border-left: 4px solid gray;
  color: #e5e6ea;
  font-weight: bold;
  font-size: 15px;
  selection-color: black;
  text-transform: uppercase;
}

#LibraryWrapper QPushButton,
#LibraryWrapper QSpinBox,
#LibraryWrapper QComboBox,
#LibraryWrapper QComboBox QAbstractScrollArea {
  background-color: #32323c;
  color: #e5e6ea;
}

WLabel {
  color: #e5e6ea;
}

#LibraryBreadcrumb {
  color: lightgray;
  font-size: 18px;
  font-weight: bold;
  padding-left: 12px;
}

/* Checkbox in library "Played" column */
#LibraryWrapper WTrackTableView::indicator:unchecked {
  image: url(skin:icons/library_checkbox.svg);
}
#LibraryWrapper WTrackTableView::indicator:hover {
  background-color: #2d85cd;
}
#LibraryWrapper WTrackTableView::indicator:checked {
  image: url(skin:icons/library_checkbox_checked.svg);
}

/************************************************************************/
/*     Library panel                                                    */
/************************************************************************/

#LibraryPanel_Sidebar {
  border-right: 1px solid #32323c;
}

/* The Play page's band is 200px, which is about six rows plus a header. Rows
 * any shorter stop being a touch target; any taller and the band eats the
 * waveforms. */
#Overview_LibraryBand {
  border-top: 1px solid #32323c;
  border-bottom: 1px solid #32323c;
}

/************************************************************************/
/*     Waveform cells                                                   */
/************************************************************************/

#WaveformHeader {
  background-color: #151515;
  padding: 0 4px;
}

#WaveformHeaderTitle {
  color: #a7a9ac;
  font-size: 13px;
  font-weight: bold;
}

#WaveformHeaderTitle[highlight="1"] {
  color: #f15921;
}

#WaveformHeaderKey {
  font-size: 13px;
}

#WaveformHeaderKey[highlight="1"] {
  color: #f15921;
}

#WaveformHeaderLoopIcon,
#WaveformHeaderBeatloopSize {
  color: #a7a9ac;
  font-size: 12px;
}

#WaveformHeaderQuantizeButton {
  image: url(skin:icons/quantize.svg) no-repeat center center;
}

#WaveformHeaderKeylockButton {
  image: url(skin:icons/keylock.svg) no-repeat center center;
}

/* The gutter between the two cells in a row, so adjacent waveforms read as two
 * pictures rather than one wide one. At 1px they did not: both panes draw on
 * #000 and butt together, and two loaded decks looked like one continuous
 * waveform. 6px was measured on the panel and judged still too tight.
 *
 * The margin comes out of the right-hand cell's own share, so the panes are
 * not equal: measured at 6px, deck 1 got 640 and deck 2 got 634. Splitting it
 * 5px a side would even that up at the cost of a stray stripe against the
 * panel edge whenever one cell of a row is hidden, which is the common case.
 *
 * It hangs off the right-hand cell, not the left one, because a hidden widget
 * contributes no margin. Deck 1 alone and the three-deck case (deck 3 spanning
 * the whole bottom row) both hide the cell that carries it, so neither gets a
 * stray stripe against the panel edge. Deck 2 or deck 4 loaded alone still
 * does, on its left; that is the rarer way to load and the cheaper wart.
 *
 * Transparent on purpose, so it shows #Mixxx's black. Do not paint it by
 * giving #WaveformRowTop or #WaveformRowBottom a background: with no decks
 * loaded both cells are hidden and the top row still expands to the whole
 * 355px band, which would put a 1280x355 slab of that colour on the screen. */
#WaveformCell2, #WaveformCell4 {
  margin-left: 10px;
}

WBeatSpinBox {
  color: #ffffff;
  font-size: 14px;
  font-weight: bold;
  background-color: #000000;
}

WBeatSpinBox::down-arrow,
WBeatSpinBox::up-arrow,
WBeatSpinBox::down-button,
WBeatSpinBox::up-button {
  width: 0px;
  height: 0px;
  color: #000000;
  background-color: #000000;
}

/************************************************************************/
/*     Tabs                                                             */
/************************************************************************/

#TabControls {
  background-color: #855ea7;
}

/* Six tabs share the bar. At 1280 each cell is ~213px, still clear of the
 * 250px cap below, so the constraint is vertical, not horizontal: the bar is
 * 44px tall and that whole 44px is the
 * button's clickable target (a QSS margin insets painting, not hit
 * geometry — WPushButton's widget rect, not its painted rect, is what
 * receives the tap). The 4px top/bottom margin only shrinks what's painted,
 * to a 36px button, which still clears a comfortable touch target at this
 * panel's ~163 dpi. Do not add a margin-bottom to #TabControls itself: that
 * steals from the layout's contents margins and shrinks the clickable
 * height below 44px, independent of what's painted. */
#TabControls WPushButton {
  font-weight: bold;
  font-size: 15px;
  margin: 4px 3%;
  max-width: 250px;
  text-transform: uppercase;
}

#TabControls WPushButton[value="0"] {
  border: 2px solid black;
  color: black;
}

#TabControls WPushButton[value="1"] {
  border: 2px solid black;
  background-color: black;
  color: #e7e8e9;
}

/* A recording runs while the DJ is on any tab, so it is badged where it can be
 * stopped: a red dot on SETTINGS, the page the USB Record buttons are on. Red
 * because that is what the Record button turns and what the drive's LED shows.
 * It sits in the top-right corner, which is the only placement that clears the
 * label: SETTINGS is the longest word on the bar and at the 480px floor its 8
 * monospace chars fill nearly the whole ~90px cell, so a badge anywhere on the
 * text's own baseline is painted over (WPushButton draws its <Text> across the
 * whole widget rect and ignores QSS padding, so the label cannot be moved out
 * of the way). The button now paints at 36px with a 15px font, leaving less
 * clear space above the cap height than the old 40px/17px pairing did, but
 * confirmed by eye on the panel — not by calculation, which is what looked
 * marginal — to still clear the label. Qt's background-position takes
 * alignment keywords only, so the inset lives in the image: recording_dot.svg
 * is a 14x14 canvas with the 10px dot at cx=5,cy=9, i.e. 4px of empty canvas
 * above it and to its right, and aligning that canvas top-right against the
 * border box puts the dot 4px in from both edges — 2px clear of the 2px
 * border. Change the inset in the SVG's width/cx and height/cy pairs
 * (width - cx - 5 and cy - 5). */
#TabControls WPushButton#TabButtonSettings[recording="1"] {
  background-image: url(skin:icons/recording_dot.svg);
  background-origin: border;
  background-position: right top;
  background-repeat: no-repeat;
}

/************************************************************************/
/*     Settings                                                         */
/************************************************************************/

#Settings {
  padding: 16px 24px;
  qproperty-layoutAlignment: 'AlignTop';
}

#SettingsRow {
  background-color: #151515;
  border-radius: 4px;
  margin-bottom: 8px;
  padding: 8px 16px;
  qproperty-layoutAlignment: 'AlignVCenter';
}

#SettingsRowLabel {
  color: #e5e6ea;
  font-size: 16px;
  font-weight: bold;
  text-transform: uppercase;
}

/* Audio -> the Priority + Devices line. The two #SettingsRow halves share one
 * 56px line, so their bottom margin becomes a gutter between them instead. */
#AudioActionRow #SettingsRow {
  margin-bottom: 0;
  padding: 8px 10px;
}

#AudioActionRow #SettingsRow + #SettingsRow {
  margin-left: 8px;
}


/* Secondary readout sitting between a row's label and its control — the
 * resolved numbers behind a preset (Audio -> Priority). Dim and small so the
 * segment stays the thing the eye lands on. */
#SettingsRowHint {
  color: #7a7a84;
  font-size: 12px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
  padding-right: 10px;
}

#SettingsSegmented {
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}

#SettingsSegmentLeft,
#SettingsSegmentMid,
#SettingsSegmentRight {
  background-color: transparent;
  border: 2px solid #855ea7;
  color: #a7a9ac;
  font-size: 14px;
  font-weight: bold;
  min-width: 80px;
  text-transform: uppercase;
}

/* Samplers MODE row carries three segments (Play/Load/Unload) plus a 2-segment
 * SOURCE row and STOP ALL on the same line — drop the min-width so the row
 * fits at the 480px floor without clipping. */
#SamplersSegmented #SettingsSegmentLeft,
#SamplersSegmented #SettingsSegmentMid,
#SamplersSegmented #SettingsSegmentRight {
  min-width: 60px;
}

/* The System page's SCREEN row carries rotation, Day/Night and Power on one
 * line so the USB drive list keeps the vertical space. At the 480px floor that
 * only clears the row width if both segment groups size to their (short)
 * labels — 0°/180° and NIGHT/DAY are at most four 14px Monospace caps, so 60px
 * still leaves them padding. */
#ScreenRotSegmented,
#ScreenModeSegmented {
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}

#ScreenRotSegmented #SettingsSegmentLeft,
#ScreenRotSegmented #SettingsSegmentRight,
#ScreenModeSegmented #SettingsSegmentLeft,
#ScreenModeSegmented #SettingsSegmentRight {
  min-width: 60px;
}

#SettingsSegmentLeft {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  border-right-width: 1px;
}

#SettingsSegmentMid {
  border-radius: 0;
  border-left-width: 1px;
  border-right-width: 1px;
}

#SettingsSegmentRight {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  border-left-width: 1px;
}

#SettingsSegmentLeft[displayValue="1"],
#SettingsSegmentMid[displayValue="1"],
#SettingsSegmentRight[displayValue="1"] {
  background-color: #855ea7;
  color: #e7e8e9;
}

#SettingsSegmentLeft[pressed="true"],
#SettingsSegmentMid[pressed="true"],
#SettingsSegmentRight[pressed="true"] {
  background-color: #2d6488;
  color: #e7e8e9;
}

/* A settings row can bind its `enabled` to the setting it depends on (General →
 * Brake binds [BiteDJ],vinyl_mode: only a released scratch can coast, so the
 * brake does nothing in CDJ jog mode). Qt propagates enabled down the widget
 * tree, so disabling the row lands on the label and every segment. The
 * selected segment keeps a muted fill rather than going flat, so the row still
 * says which value is stored and will apply again once the mode comes back. */
#SettingsRowLabel:disabled {
  color: #5c707d;
}

#SettingsSegmentLeft:disabled,
#SettingsSegmentMid:disabled,
#SettingsSegmentRight:disabled {
  border-color: #2b3f4d;
  color: #5c707d;
}

#SettingsSegmentLeft[displayValue="1"]:disabled,
#SettingsSegmentMid[displayValue="1"]:disabled,
#SettingsSegmentRight[displayValue="1"]:disabled {
  background-color: rgba(72, 138, 179, 0.18);
  color: #8a99a4;
}

/* Samplers → DRIVE. One chip per mounted USB drive, built at runtime by
 * WSamplerDrive: the choices are whatever is plugged in, so this is a list
 * whose length changes rather than the fixed left/mid/right strip the
 * segmented selectors below the grid are. Same fill and border as those, so
 * the selected drive reads as the same kind of choice, but each chip is
 * rounded on all four corners because it stands alone. Chips are
 * SizePolicy::Ignored and share the strip evenly, so min-width is the floor
 * that keeps four drives tappable rather than a target size. */
#SamplerDriveChip {
  background-color: transparent;
  border: 2px solid #855ea7;
  border-radius: 4px;
  color: #a7a9ac;
  font-size: 14px;
  font-weight: bold;
  min-width: 60px;
  padding: 0 6px;
  text-transform: uppercase;
}

#SamplerDriveChip[selected="true"] {
  background-color: #855ea7;
  color: #e7e8e9;
}

/* Nothing plugged in, or the drive the samples live on is not here. Muted
 * rather than styled as a chip: it is not something to tap. */
#SamplerDrivePlaceholder {
  color: #5c707d;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#SettingsActionButton {
  background-color: transparent;
  border: 2px solid #855ea7;
  border-radius: 4px;
  color: #e7e8e9;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#SettingsActionButton[pressed="true"] {
  background-color: #2d6488;
}

/* The Audio Rescan button binds `enabled` to [AudioDevices],reconfigure_enabled,
 * which drops to 0 while a deck plays — rescanning re-opens the devices and
 * would cut the music. */
#SettingsActionButton:disabled {
  border-color: #2b3f4d;
  color: #5c707d;
}

/* Filled accent variant for the commit action (Apply) so un-applied staged
 * settings read as a pending decision next to the outline Cancel. */
#SettingsPrimaryButton {
  background-color: #855ea7;
  border: 2px solid #855ea7;
  border-radius: 4px;
  color: #e7e8e9;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
  margin-right: 6px;
}

#SettingsPrimaryButton[pressed="true"] {
  background-color: #2d6488;
  border-color: #2d6488;
}

/* Audio Apply binds `enabled` to [AudioDevices],reconfigure_enabled, which
 * drops to 0 while a deck is playing (applying re-opens the devices and would
 * cut the music). Paint it dimmed so the block reads as deliberate. */
#SettingsPrimaryButton:disabled {
  background-color: rgba(72, 138, 179, 0.12);
  border-color: #2b3f4d;
  color: #5c707d;
}

#SettingsSubtabBar {
  margin: 0 0 8px 0;
}

#SettingsSubtabBar WPushButton {
  background-color: transparent;
  border: 2px solid #32323c;
  color: #a7a9ac;
  font-size: 14px;
  font-weight: bold;
  margin: 0 4px;
  text-transform: uppercase;
}

#SettingsSubtabBar WPushButton[value="1"] {
  background-color: #855ea7;
  border-color: #855ea7;
  color: #e7e8e9;
}

#SettingsPanel {
  qproperty-layoutAlignment: 'AlignTop';
}

/* The General sub-page packs two columns of rows at the 480px floor: trim row
 * padding, label font and segment min-width so label + control fit a ~200px
 * half-column without clipping. */
#GeneralCol {
  qproperty-layoutAlignment: 'AlignTop';
  padding: 0 4px;
}

#GeneralCol #SettingsRow {
  margin-bottom: 6px;
  padding: 4px 8px;
}

#GeneralCol #SettingsRowLabel {
  font-size: 13px;
}

#GeneralCol #SettingsSegmentLeft,
#GeneralCol #SettingsSegmentMid,
#GeneralCol #SettingsSegmentRight {
  min-width: 40px;
  font-size: 12px;
}

#GeneralCol #SettingsActionButton {
  font-size: 12px;
}

#LibraryColumnsCol {
  qproperty-layoutAlignment: 'AlignTop';
  padding: 0 4px;
}

#LibraryColumnRow {
  background-color: #151515;
  border-radius: 4px;
  margin-bottom: 2px;
  padding: 2px 12px;
  qproperty-layoutAlignment: 'AlignVCenter';
}

#LibraryColumnRowLabel {
  color: #e5e6ea;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#LibraryColumnVisibleButton {
  background-color: transparent;
  border: 2px solid #855ea7;
  border-radius: 4px;
  color: #a7a9ac;
  font-size: 12px;
  font-weight: bold;
  margin-right: 8px;
}

#LibraryColumnVisibleButton[value="1"] {
  background-color: #855ea7;
  color: #e7e8e9;
}

#LibraryColumnVisibleButton[pressed="true"] {
  background-color: #2d6488;
  color: #e7e8e9;
}

#LibraryColumnSegmented {
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}

#LibraryColumnSegmented WPushButton {
  font-size: 12px;
  min-width: 32px;
}

/************************************************************************/
/*     Samplers                                                         */
/************************************************************************/

#SamplersHeader {
  padding: 4px 12px 8px 12px;
}

#SamplersHeaderGroup {
  margin: 0 6px;
  qproperty-layoutAlignment: 'AlignVCenter';
}

#SamplersHeaderLabel {
  color: #a7a9ac;
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
  qproperty-alignment: 'AlignRight | AlignVCenter';
  padding-right: 6px;
}

#SamplersSegmented {
  qproperty-layoutAlignment: 'AlignVCenter';
}

/* Deck-row identity badges — colored block at the start of each row so the
 * channel association is glanceable. Sampler wrappers use 0me width so the
 * 8 buttons reflow narrower at the 480f minimum to make room. */
#SamplersBankBadgeL, #SamplersBankBadgeR {
  border-radius: 2px;
  color: #1a1a1a;
  font-size: 18px;
  font-weight: bold;
  margin: 4px 2px 4px 4px;
  qproperty-alignment: 'AlignCenter';
}

#SamplersBankBadgeL {
  background-color: #855ea7;
}

#SamplersBankBadgeR {
  background-color: #c9372c;
}

/* PLAY-mode sampler button.
 *   loaded=0  → dim outline (empty slot, title row is empty)
 *   loaded=1  → red outline (sample loaded, idle)
 *   value=1   → solid red fill (sample playing) */
#Sampler {
  background-color: #32323c;
  border: 2px solid #4a4a55;
  border-radius: 2px;
  margin: 2px 4px 4px 4px;
}

#Sampler[loaded="1"] {
  border: 2px solid #d73535;
}

#Sampler[value="1"] {
  background-color: #d73535;
  border: 2px solid #d73535;
}

#Sampler[value="1"]:hover {
  background-color: #d73535;
  border: 2px solid #d73535;
}

/* LOAD-mode button: amber palette so the user knows the next press loads. */
#SamplerLoad {
  background-color: rgba(241, 89, 33, 0.18);
  border: 2px dashed #c9372c;
  border-radius: 2px;
  color: #c9372c;
  font-size: 11px;
  font-weight: bold;
  margin: 2px 4px 4px 4px;
  text-transform: uppercase;
}

#SamplerLoad:hover {
  background-color: rgba(241, 89, 33, 0.28);
  border: 2px dashed #c9372c;
}

#SamplerLoad[loaded="1"] {
  background-color: rgba(241, 89, 33, 0.30);
}

#SamplerLoad[loaded="1"]:hover {
  background-color: rgba(241, 89, 33, 0.40);
}

#SamplerLoad[pressed="true"] {
  background-color: #c9372c;
  color: #1a1a1a;
}

/* UNLOAD-mode button: red destructive palette when a track is loaded; the
 * widget's `enabled` property is bound to track_loaded, so empty slots are
 * disabled (and dimmed) to avoid Mixxx's eject-on-empty reload-last-ejected
 * gesture. */
#SamplerUnload {
  background-color: rgba(215, 53, 53, 0.22);
  border: 2px dashed #d73535;
  border-radius: 2px;
  color: #d73535;
  font-size: 11px;
  font-weight: bold;
  margin: 2px 4px 4px 4px;
  text-transform: uppercase;
}

#SamplerUnload:hover {
  background-color: rgba(215, 53, 53, 0.32);
}

#SamplerUnload:disabled {
  background-color: rgba(215, 53, 53, 0.06);
  border: 2px dashed #5a2020;
  color: #5a2020;
}

#SamplerUnload[pressed="true"] {
  background-color: #d73535;
  color: #1a1a1a;
}

/* Track title sits directly above its sampler button. Small + elided. */
#Sampler_Info {
  color: #e5e6ea;
  font-size: 10px;
  font-weight: bold;
  padding: 0 2px;
  qproperty-alignment: 'AlignBottom | AlignHCenter';
}

/* STOP ALL — destructive palette so users register it as a panic button
 * rather than a toggle. */
#SamplersStopAll {
  background-color: transparent;
  border: 2px solid #d73535;
  border-radius: 4px;
  color: #d73535;
  font-size: 13px;
  font-weight: bold;
  margin: 0 12px;
  text-transform: uppercase;
}

#SamplersStopAll:hover {
  background-color: rgba(215, 53, 53, 0.18);
  border: 2px solid #d73535;
}

#SamplersStopAll[pressed="true"] {
  background-color: #d73535;
  color: #1a1a1a;
}

/************************************************************************/
/*     Soft-takeover indicator                                          */
/************************************************************************/

/* Overlays the topbar tabs in a stacked layout — background must stay
   opaque so the tab buttons don't bleed through. */
#SoftTakeoverStrip {
  background-color: #140d00;
  border-top: 1px solid #402900;
  border-bottom: 1px solid #402900;
}

#SoftTakeoverLabel {
  color: #c9372c;
  font-size: 16px;
  font-weight: bold;
  qproperty-alignment: 'AlignCenter';
}

/************************************************************************/
/*     Inline notification strip                                        */
/************************************************************************/

/* Overlays the topbar tabs in a stacked layout — background must stay
   opaque so the tab buttons don't bleed through. */
#NotificationStrip {
  background-color: #1a1100;
  border-top: 1px solid;
  border-bottom: 1px solid;
}

#NotificationStrip #NotificationLabel {
  font-size: 16px;
  font-weight: bold;
  qproperty-alignment: 'AlignCenter';
}

#NotificationStrip[severity="info"],
#NotificationStrip[severity="warning"],
#NotificationStrip[severity="error"] {
  background-color: #1a1100;
  border-color: #593a00;
}
#NotificationStrip[severity="info"] #NotificationLabel,
#NotificationStrip[severity="warning"] #NotificationLabel,
#NotificationStrip[severity="error"] #NotificationLabel {
  color: #c9372c;
}

#SettingsHeader {
  color: #a7a9ac;
  font-size: 13px;
  font-weight: bold;
  margin: 0 4px 4px 4px;
  text-transform: uppercase;
}

#SettingsVersionLabel {
  color: #5c5e61;
  font-size: 11px;
}

/************************************************************************/
/*     Levels                                                           */
/************************************************************************/

/* Tighter than #Settings' 16px/24px: the page stacks two knob rows, two
 * headers and the deck strip inside the 420px-floor height. */
#Levels {
  padding: 10px 16px;
  qproperty-layoutAlignment: 'AlignTop';
}

#LevelRow {
  background-color: #151515;
  border-radius: 4px;
  margin-bottom: 8px;
  padding: 8px 4px;
}

/* No qproperty-layoutAlignment here on purpose. WWidgetGroup forwards it to
 * QLayout::setAlignment, which only positions a layout inside its *parent
 * layout* — a top-level layout ignores it, so it can't centre a fixed-width
 * knob in a wider column. The columns' children are all full-width instead
 * (KnobComposed at 0me paints its knob centred via STRETCH_ASPECT). */
#LevelKnobLabel {
  color: #a7a9ac;
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
}

#LevelKnobValue {
  color: #e5e6ea;
  font-size: 12px;
}

/* Levels -> master EQ: eight band columns plus the Flat reset share the row
 * width equally so the page still fits at the 480px floor (9 x ~48px). */
#EQBandRow {
  background-color: #151515;
  border-radius: 4px;
  margin-bottom: 8px;
  padding: 8px 4px;
}

#EQBand {
  qproperty-layoutAlignment: 'AlignHCenter | AlignVCenter';
}

#EQBandLabel {
  color: #a7a9ac;
  font-size: 12px;
  font-weight: bold;
}

#EQBandValue {
  color: #e5e6ea;
  font-size: 12px;
}

/* Levels -> EQ vs Isolator. Same outline shape as the Flat button beside it,
 * because it is the same 44px column, but it names a state rather than an
 * action: the label is the mode that is live now, and ISO fills so the more
 * aggressive curve is visible from arm's length without reading the word.
 * 13px, not the 14px the action buttons use — ISO plus the borders has 44px
 * to live in. */
#EQModeButton {
  background-color: transparent;
  border: 2px solid #488ab3;
  border-radius: 4px;
  color: #a7a9ac;
  font-size: 13px;
  font-weight: bold;
  text-transform: uppercase;
}

#EQModeButton[displayValue="1"] {
  background-color: #488ab3;
  color: #e7e8e9;
}

#EQModeButton[pressed="true"] {
  background-color: #2d6488;
  color: #e7e8e9;
}

#AudioDeviceList #AudioDeviceRow {
  background-color: #151515;
  border: 2px solid #151515;
  border-radius: 4px;
  color: #e5e6ea;
  font-size: 16px;
  font-weight: bold;
  min-height: 56px;
  padding: 0 16px;
  text-align: left;
  text-transform: uppercase;
}

#AudioDeviceList #AudioDeviceRow[assigned="false"] {
  color: #7a7a84;
  border-style: dashed;
  border-color: #32323c;
}

#AudioDeviceList #AudioDeviceRow:pressed {
  background-color: #2d6488;
}

#AudioDeviceList #AudioDeviceRow[empty="true"] {
  background-color: transparent;
  border: 2px dashed #32323c;
  color: #5a5a64;
}

#ControllerList #ControllerRow {
  background-color: #151515;
  border: 2px solid #151515;
  border-radius: 4px;
  color: #e5e6ea;
  font-size: 16px;
  font-weight: bold;
  min-height: 56px;
  padding: 0 16px;
  text-align: left;
  text-transform: uppercase;
}

#ControllerList #ControllerRow[active="true"] {
  background-color: #2d6488;
  border-color: #855ea7;
}

#ControllerList #ControllerRow:pressed {
  background-color: #2d6488;
}

#ControllerList #ControllerRow[empty="true"] {
  background-color: transparent;
  border: 2px dashed #32323c;
  color: #5a5a64;
}

/* The rows live in a scroll area so more drives / controllers than fit the
 * panel can be reached by dragging; the panel behind it has to keep showing
 * through. */
#UsbList #UsbScrollArea,
#UsbList #UsbScrollContent,
#ControllerList #ControllerScrollArea,
#ControllerList #ControllerScrollContent {
  background-color: transparent;
  border: 0;
}

/* Wide enough to grab with a fingertip, with the handle inset so it still
 * reads as a slim indicator. Track colours follow the library's scroll bar. */
#UsbList QScrollBar:vertical,
#ControllerList QScrollBar:vertical {
  background-color: #151515;
  border: 0;
  border-radius: 4px;
  margin: 0;
  width: 18px;
}

#UsbList QScrollBar::handle:vertical,
#ControllerList QScrollBar::handle:vertical {
  background-color: #855ea7;
  border: 0;
  border-radius: 5px;
  margin: 0 4px;
  min-height: 44px;
}

#UsbList QScrollBar::handle:vertical:pressed,
#ControllerList QScrollBar::handle:vertical:pressed {
  background-color: #7fb2d6;
}

#UsbList QScrollBar::add-page:vertical,
#UsbList QScrollBar::sub-page:vertical,
#ControllerList QScrollBar::add-page:vertical,
#ControllerList QScrollBar::sub-page:vertical {
  background-color: transparent;
}

#UsbList QScrollBar::add-line:vertical,
#UsbList QScrollBar::sub-line:vertical,
#ControllerList QScrollBar::add-line:vertical,
#ControllerList QScrollBar::sub-line:vertical {
  height: 0;
  width: 0;
}

/* Drive name label carries the row's appearance (there is no container widget). */
#UsbList #UsbRowLabel {
  background-color: #151515;
  border: 2px solid #151515;
  border-radius: 4px;
  color: #e5e6ea;
  font-size: 16px;
  font-weight: bold;
  min-height: 56px;
  padding: 0 16px;
  text-transform: uppercase;
}

/* Per-row Record and Eject buttons: outlined and clearly actionable at rest,
 * filled with the highlight colour only while pressed. Both sit at min-width 96
 * rather than the 110 Eject had to itself — two buttons plus a drive name is all
 * the 400px this panel gets at the 480px floor will take, and 96 still leaves
 * EJECT and RECORD their width with room over the 44px touch floor. */
#UsbList #UsbEjectButton,
#UsbList #UsbRecordButton {
  background-color: transparent;
  border: 2px solid #855ea7;
  border-radius: 4px;
  color: #7fb2d6;
  font-size: 14px;
  font-weight: bold;
  min-height: 56px;
  min-width: 96px;
  padding: 0 14px;
  text-transform: uppercase;
}

#UsbList #UsbEjectButton:pressed,
#UsbList #UsbRecordButton:pressed {
  background-color: #2d6488;
  color: #e5e6ea;
}

/* Recording: filled red, the one colour that means this on any deck ever built
 * (and the LED state for a drive that must not be pulled). */
#UsbList #UsbRecordButton[recording="true"] {
  background-color: #7a2622;
  border-color: #c2453d;
  color: #f0d5d2;
}

#UsbList #UsbRecordButton[recording="true"]:pressed {
  background-color: #97302a;
  color: #ffffff;
}

/* Only one drive can be recorded to, so the others go flat for the duration —
 * paired with the disabled widget swallowing the tap rather than queueing it,
 * the same way the Audio page's Apply does while a deck is playing. */
#UsbList #UsbRecordButton:disabled {
  border-color: #32323c;
  color: #5a5a64;
}

/* First tap arms the button; it turns danger-red to mirror the safe-to-remove
 * LED state and prompts the confirming second tap. */
#UsbList #UsbEjectButton[armed="true"] {
  background-color: #7a2622;
  border-color: #c2453d;
  color: #f0d5d2;
}

#UsbList #UsbEjectButton[armed="true"]:pressed {
  background-color: #97302a;
  color: #ffffff;
}

/* Empty-state placeholder row (a QLabel). */
#UsbList #UsbRow[empty="true"] {
  background-color: transparent;
  border: 2px dashed #32323c;
  border-radius: 4px;
  color: #5a5a64;
  font-size: 16px;
  font-weight: bold;
  min-height: 56px;
  padding: 0 16px;
  text-transform: uppercase;
}

#SettingsDangerButton {
  background-color: transparent;
  border: 2px solid #c2453d;
  border-radius: 4px;
  color: #e7e8e9;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#SettingsDangerButton[pressed="true"] {
  background-color: #7a2622;
}

/************************************************************************/
/*     Deck strips                                                      */
/************************************************************************/

/* Four strips share 1280, so each gets ~320px, and the type is sized for
 * that rather than for the 640 two strips used to have. */
#DeckStrips {
  background-color: #151515;
}

#DeckStrip {
  border: 1px solid transparent;
  border-radius: 2px;
  padding: 2px 6px;
}

/* Every child here is f or max, so none of them expands to soak up the
 * slack — without an explicit alignment the layout centres the row as a
 * block instead of packing it to the strip's left edge. */
#DeckStripHeader {
  padding: 0;
  qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
}

/* The transparent border is load-bearing: it reserves the 1px the master
 * state paints, so the badge's content box is identical in both states and
 * DECK1 cannot shift or clip when a deck takes the leader role. Same trick
 * #DeckStrip uses above. */
#DeckStripBadge {
  border: 1px solid transparent;
  border-radius: 2px;
  color: #a7a9ac;
  font-size: 13px;
  font-weight: bold;
}

#DeckStripBadge[highlight="1"] {
  color: #f15921;
}

/* The assumed reference: no deck has taken the leader role, so EngineSync fell
 * back to the playing deck and syncreference.cpp published it. Muted, because
 * this is an inference rather than something the user asked for. Must come
 * before the master rules: the leader is always also the reference, both
 * properties are 1 on that deck, and equal specificity means last wins. */
#DeckStripBadge[reference="1"] {
  background-color: #241b30;
  border-color: #55446b;
}

/* Sync leader. Set border and fill only, never color, so playing and master
 * compose: an orange DECK1 inside a purple chip is both at once. States 1 and
 * 2 are soft and explicit leader; explicit is unreachable today because
 * SyncControl only ever requests soft, but styling it costs one selector.
 * Placed after the highlight rule because equal specificity means last wins. */
#DeckStripBadge[master="1"],
#DeckStripBadge[master="2"] {
  background-color: #3d2d52;
  border-color: #855ea7;
}

#DeckStripKey {
  font-size: 13px;
}

#DeckStripKey[highlight="1"] {
  color: #f15921;
}

#DeckStripBpm {
  font-size: 15px;
  font-weight: bold;
}

#DeckStripBpm[highlight="1"] {
  color: #c9372c;
}

#DeckStripCueChip {
  border: 1px solid #855ea7;
  border-radius: 2px;
  color: #e7e8e9;
  font-size: 12px;
}

/* Eject at rest: the Cue chip's outline, so the pair reads as one row of
 * chips and neither shouts. The armed state carries all the weight. */
#DeckStripEjectChip {
  border: 1px solid #855ea7;
  border-radius: 2px;
  color: #e7e8e9;
  font-size: 12px;
}

#DeckStripEjectChip:pressed {
  background-color: #2d6488;
  color: #e5e6ea;
}

/* Armed: the USB eject button's danger red, deliberately. It is the same
 * arm-then-confirm gesture in the same colour the user already met on the
 * Settings page, and the only filled chip in the strip.
 *
 * 11px against the Cue chip's 12 because EJECT is five characters inside 44px
 * less two borders. Measure it on the panel; if it still clips, widen both
 * chips to 48f rather than shrinking the type again. */
#DeckStripEjectChipArmed {
  background-color: #7a2622;
  border: 1px solid #c2453d;
  border-radius: 2px;
  color: #f0d5d2;
  font-size: 11px;
  font-weight: bold;
}

#DeckStripEjectChipArmed:pressed {
  background-color: #97302a;
  color: #ffffff;
}

#DeckStripTitle {
  color: #e7e8e9;
  font-size: 15px;
  font-weight: bold;
}

#DeckStripArtist {
  color: #a7a9ac;
  font-size: 12px;
}

#DeckStripTime {
  font-size: 22px;
}

#DeckStripTime[highlight="1"] {
  color: #f15921;
}

/* The strip shows the whole summary, not the top half of a double-height one
 * the way the old deck.xml did, so there is no negative margin here. */
#DeckStripOverview {
  margin: 0;
}
