<!DOCTYPE template>
<!--
  The explorer and the track table side by side, used by both the Play page and
  the Browse page.

  The two library widgets are singletons because Mixxx allows exactly one of
  each: LegacySkinParser::parseLibrary calls Library::bindLibraryWidget, and a
  second instance would rebind it. WSingletonContainer::showEvent reparents the
  one instance into whichever container just became visible, and only one tab is
  visible at a time, so Play and Browse hand the same widgets back and forth.
  Scroll position and selection survive the switch, which is a small win.

  ObjectName is LibraryWrapper, not a panel-specific name: every library rule
  in style.qss from roughly line 417 to 537 (scrollbars, the track table
  header, qproperty-trackPlayedColor, table/text-browser backgrounds, the
  sidebar block, the Played/BPM checkbox indicators) is scoped under the
  #LibraryWrapper ancestor selector, and browsetablemodel.cpp's
  TintedTextDelegate depends on #LibraryWrapper QTableView's `color` rule to
  set Qt::ForegroundRole. Reusing the name here means this panel is a
  #LibraryWrapper wherever it is parented, so those rules match identically on
  Play and Browse, without unscoping any of them to a bare Qt class (which
  would leak the library's theming onto every table/scrollbar/button
  elsewhere in the skin). Qt object names need not be unique: on Browse this
  nests inside library.xml's own LibraryWrapper, which is harmless.
-->
<Template>
  <WidgetGroup>
    <ObjectName>LibraryWrapper</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>LibraryPanel_Sidebar</ObjectName>
        <Layout>vertical</Layout>
        <Size>180f,0me</Size>
        <Children>
          <LibraryBreadcrumb>
            <ObjectName>LibraryBreadcrumb</ObjectName>
            <Size>0me,26f</Size>
            <Alignment>left</Alignment>
            <Elide>left</Elide>
          </LibraryBreadcrumb>
          <SingletonContainer>
            <ObjectName>Sidebar_Singleton</ObjectName>
          </SingletonContainer>
        </Children>
      </WidgetGroup>

      <SingletonContainer>
        <ObjectName>TrackTable_Singleton</ObjectName>
      </SingletonContainer>

    </Children>
  </WidgetGroup>
</Template>
