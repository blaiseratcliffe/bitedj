<!--
  The bottom row of the Overview: normally the two deck strips, and when the
  cue drawer is opened, the pads for one deck in their place.

  This is one WidgetStack whose page 0 *is* the deck strips, so "closed" is a
  page rather than a hidden widget. Tapping a deck's CUE chip writes that
  deck's trigger ([Skin],cue_deck1 through cue_deck4), which both selects the
  deck and opens the drawer in a single press; the drawer's X writes
  [Skin],cue_close to go back to page 0. That is the same select-only trigger
  pattern as the FX / KEY tabs, and it avoids needing a button that writes two
  controls at once.

  Closed costs nothing but the chips in the deck headers. The drawer only ever
  covers the deck strips, which are readouts — the waveforms, which are not,
  stay put. Every page carries the same MaximumSize of 120 as the Decks group
  it replaces, so the waveform row above does not resize when the drawer
  opens (WWidgetStack forwards its minimumSizeHint to the current page).
  MaximumSize is a real cap; the old 150max was a SizePolicy suffix and set a
  minimum, not a cap, which is why the band used to reserve dead space.

  [Skin],cue_bank selects which bank the pads address (0 hot, 1 memory) and is
  shared by all four deck pages, so the bank survives switching decks. None of
  these controls are persisted: the drawer opens closed, on hot cues.
-->
<Template>
  <WidgetStack currentpage="[Skin],cue_panel">
    <ObjectName>CuePanel_Stack</ObjectName>
    <MaximumSize>-1,120</MaximumSize>
    <SizePolicy>me,max</SizePolicy>
    <Children>

      <WidgetGroup trigger="[Skin],cue_close">
        <ObjectName>Decks</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,max</SizePolicy>
        <MaximumSize>-1,120</MaximumSize>
        <Children>
          <Template src="skin:deckstrips.xml"></Template>
        </Children>
      </WidgetGroup>

      <WidgetGroup trigger="[Skin],cue_deck1">
        <ObjectName>CuePanel</ObjectName>
        <Layout>horizontal</Layout>
        <MaximumSize>-1,120</MaximumSize>
        <SizePolicy>me,max</SizePolicy>
        <Children>
          <Template src="skin:templates/cue_deck_page.xml">
            <SetVariable name="channel">1</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <WidgetGroup trigger="[Skin],cue_deck2">
        <ObjectName>CuePanel</ObjectName>
        <Layout>horizontal</Layout>
        <MaximumSize>-1,120</MaximumSize>
        <SizePolicy>me,max</SizePolicy>
        <Children>
          <Template src="skin:templates/cue_deck_page.xml">
            <SetVariable name="channel">2</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <WidgetGroup trigger="[Skin],cue_deck3">
        <ObjectName>CuePanel</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,max</SizePolicy>
        <MaximumSize>-1,120</MaximumSize>
        <Children>
          <Template src="skin:templates/cue_deck_page.xml">
            <SetVariable name="channel">3</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <WidgetGroup trigger="[Skin],cue_deck4">
        <ObjectName>CuePanel</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,max</SizePolicy>
        <MaximumSize>-1,120</MaximumSize>
        <Children>
          <Template src="skin:templates/cue_deck_page.xml">
            <SetVariable name="channel">4</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetStack>
</Template>
