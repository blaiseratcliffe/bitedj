<!DOCTYPE template>
<!--
  The Play page, top to bottom: the 2x2 waveform grid, the library panel, then
  the deck strips or the cue drawer in their place.

  The FX/Key panel used to sit in a 180px column beside the grid. It has its
  own top-level tab now (effects.xml, mounted from skin.xml's TabStack), so the
  waveforms have the full 1280 and the panel has a whole page instead of a
  strip. Waveforms_Container is left in place with its one remaining child
  because it is what gives the grid its me,me policy under Overview.

  The library band is fixed at 200f. It is the one element here that should not
  flex: the waveform grid above it absorbs every change in the strip band's
  height, and a track table that resized with it would reflow its rows under
  the reader's finger.
-->
<Template>
  <WidgetGroup>
    <ObjectName>Overview</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>Waveforms_Container</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>
          <Template src="skin:waveforms.xml"></Template>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>Overview_LibraryBand</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,200f</Size>
        <Children>
          <Template src="skin:librarypanel.xml"></Template>
        </Children>
      </WidgetGroup>

      <!-- Deck strips, or the cue drawer in their place. -->
      <Template src="skin:cuepanel.xml"></Template>

    </Children>
  </WidgetGroup>
</Template>
