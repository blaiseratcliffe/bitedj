<!--
  One parameter row in an effect slot column on the FX tab. Visibility binds
  to parameter{N}_loaded so the row collapses when an effect doesn't expose
  this slot. Slot index N is positional within the loaded effect, not tied to
  a named parameter.

  Both kinds of parameter render. Beats-typed ones (parameter{N}_units == 1)
  get the bucket picker below; everything else gets a continuous knob. The
  knob used to be hidden behind a [Skin],beatfx_show_param{N} opt-in, for
  reasons that expired when this panel became a tab: see branch B.

  Bucket mapping: labels read as period in beats (⅛, ¼, ½, 1, 2, 4),
  and the written value is rate in cycles per beat (1/period). Matches
  Tremolo's `rate` (the most-user-visible Beats parameter). For
  period-semantic parameters (Echo delay_time, Phaser lfo_period) the
  labels read inverted under this mapping — flag if those effects need
  per-parameter inverse pairings.

  Skin connections only bind one CO per visibility binding and have no
  AND/OR transform, so the composite visibility is built out of nested
  WidgetGroups.

  See CLAUDE.md "Mixxx fork patches" for the fork-side surface that
  exposes parameter{N}_units.
-->
<Template>
  <SetVariable name="EffectGroup">[EffectRack<Variable name="rack"/>_EffectUnit<Variable name="unit"/>_Effect<Variable name="effect"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>BeatFX_ParamRow</ObjectName>
    <Layout>vertical</Layout>
    <!-- max, not min. QSizePolicy::Minimum carries the grow flag, so with
         min these rows expanded and split the column's slack with the
         trailing BeatFX_Spacer: a single-parameter effect drew its one knob
         centred halfway down the column instead of under the Active toggle.
         Maximum can only shrink, so the row hugs its content and the spacer
         takes the rest. -->
    <SizePolicy>me,max</SizePolicy>
    <Children>

      <!--
        Branch A (Beats-typed parameters): label + bucket picker, two
        rows of three buttons. Always visible when loaded.
      -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>

          <EffectParameterName>
            <ObjectName>BeatFX_ParamLabel</ObjectName>
            <Size>0me,0me</Size>
            <Alignment>left</Alignment>
            <Elide>right</Elide>
            <EffectRack><Variable name="rack"/></EffectRack>
            <EffectUnit><Variable name="unit"/></EffectUnit>
            <Effect><Variable name="effect"/></Effect>
            <EffectParameter><Variable name="param"/></EffectParameter>
          </EffectParameterName>

          <WidgetGroup>
            <ObjectName>BeatFX_BucketRow</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,36f</Size>
                <Children>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">⅛</SetVariable>
                    <SetVariable name="Value">8</SetVariable>
                  </Template>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">¼</SetVariable>
                    <SetVariable name="Value">4</SetVariable>
                  </Template>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">½</SetVariable>
                    <SetVariable name="Value">2</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,36f</Size>
                <Children>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">1</SetVariable>
                    <SetVariable name="Value">1</SetVariable>
                  </Template>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">2</SetVariable>
                    <SetVariable name="Value">0.5</SetVariable>
                  </Template>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">4</SetVariable>
                    <SetVariable name="Value">0.25</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

        </Children>
        <Connection>
          <ConfigKey><Variable name="EffectGroup"/>,parameter<Variable name="param"/>_units</ConfigKey>
          <BindProperty>visible</BindProperty>
          <Transform>
            <IsEqual>1</IsEqual>
          </Transform>
        </Connection>
      </WidgetGroup>

      <!--
        Branch B (non-Beats parameters): label + continuous knob. Shown
        whenever the slot is loaded and its parameter is not Beats-typed.

        It used to be hidden behind a persisted [Skin],beatfx_show_param{N}
        opt-in, because at 800x480 in a 180px side column the knobs ate the
        vertical space the deck select needed. That column is gone: this is a
        whole 1280x676 tab now, four slot columns of about 300px each, and the
        room the opt-in was rationing does not need rationing. Leaving it in
        made the page actively wrong: Loudness and Graphic EQ expose only
        continuous parameters, so loading either one filled its column with
        nothing at all.
      -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>

              <EffectParameterName>
                <ObjectName>BeatFX_ParamLabel</ObjectName>
                <Size>0me,0me</Size>
                <Alignment>left</Alignment>
                <Elide>right</Elide>
                <EffectRack><Variable name="rack"/></EffectRack>
                <EffectUnit><Variable name="unit"/></EffectUnit>
                <Effect><Variable name="effect"/></Effect>
                <EffectParameter><Variable name="param"/></EffectParameter>
              </EffectParameterName>

              <EffectParameterKnobComposed>
                <ObjectName>BeatFX_ParamKnob</ObjectName>
                <Size>44f,44f</Size>
                <Knob scalemode="STRETCH_ASPECT">icons/knob.svg</Knob>
                <MinAngle>-230</MinAngle>
                <MaxAngle>50</MaxAngle>
                <EffectRack><Variable name="rack"/></EffectRack>
                <EffectUnit><Variable name="unit"/></EffectUnit>
                <Effect><Variable name="effect"/></Effect>
                <EffectParameter><Variable name="param"/></EffectParameter>
                <Connection>
                  <ConfigKey><Variable name="EffectGroup"/>,parameter<Variable name="param"/></ConfigKey>
                </Connection>
              </EffectParameterKnobComposed>

            </Children>
            <Connection>
              <ConfigKey><Variable name="EffectGroup"/>,parameter<Variable name="param"/>_units</ConfigKey>
              <BindProperty>visible</BindProperty>
              <Transform>
                <IsEqual>1</IsEqual>
                <Not/>
              </Transform>
            </Connection>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

    </Children>

    <Connection>
      <ConfigKey><Variable name="EffectGroup"/>,parameter<Variable name="param"/>_loaded</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
